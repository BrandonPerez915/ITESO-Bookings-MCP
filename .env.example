# You have to set either a GEMINI_API_KEY or a OPENAI_API_KEY in your .env file to use the LangChain Agent with LLMs.
GEMINI_API_KEY=Your_Gemini_API_Key_Here
OPENAI_API_KEY=Your_OpenAI_API_Key_Here

# You have to fill all your student data in the .env file to allow the LangChain Agent to function properly and make bookings automatically.
STUDENT_NAME=Your_Full_Name_Here
STUDENT_EMAIL=Your_Email_Here
STUDENT_EXPEDIENTE=Your_Expediente_Number_Here
STUDENT_PHONE=Your_Phone_Number_Here
